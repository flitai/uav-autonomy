vcpkg_download_distfile(ARCHIVE
    URLS "https://codeload.github.com/SRombauts/SQLiteCpp/tar.gz/refs/tags/1.3.1"
    FILENAME "sqlitecpp-1.3.1.tar.gz"
    SHA512 5ce60bb255393b8e9572f73ea02fd91b723057a7e73838c89f3c2696654da38e148f147a60b207fe13f9e66dc5df577cc0f4655c95576866b850ae8627224d75
)
vcpkg_extract_source_archive(SOURCE_PATH ARCHIVE "${ARCHIVE}" PATCHES windows.patch)
vcpkg_cmake_configure(SOURCE_PATH "${SOURCE_PATH}" OPTIONS
    -DSQLITECPP_INTERNAL_SQLITE=OFF -DSQLITE_ENABLE_COLUMN_METADATA=ON
    -DSQLITECPP_RUN_CPPLINT=OFF -DSQLITECPP_RUN_CPPCHECK=OFF -DSQLITECPP_RUN_DOXYGEN=OFF
    -DSQLITECPP_BUILD_EXAMPLES=OFF -DSQLITECPP_BUILD_TESTS=OFF -DCMAKE_CXX_STANDARD=14)
vcpkg_cmake_install()
file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/debug")
vcpkg_install_copyright(FILE_LIST "${SOURCE_PATH}/LICENSE.txt")
